# Example environment variables for the School Event Scheduler backend.
# Copy this file to `.env` and replace the placeholder values with your own.
# NEVER commit the real `.env` file to Git.

# MongoDB connection string.
# Local MongoDB (default install, no auth):
#   mongodb://127.0.0.1:27017/<databaseName>
# MongoDB Atlas (cloud):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<databaseName>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# Port the Express server will listen on.
PORT=5000